  "dialogs": [
    {
      "character_id": "socrates",
      "question": "Ο Παύλος μιλά για την Εκκλησία ως σώμα με πολλά μέλη. Γιατί η διαφορετική λειτουργία δεν σημαίνει διαφορετική αξία;",
      "answer": "Κάθε μέλος συνεισφέρει διαφορετικά και κανένα δεν είναι αυτάρκες. Η αξία φαίνεται στη σχέση και στην υπηρεσία του κοινού σώματος."
    },
    {
      "character_id": "monk compressed.glb",
      "question": "Ο μαθητής λέει «Κεφαλή είναι οι ιεράρχες». Πώς κρατάμε την αναλογία χρήσιμη χωρίς να ξεχνούμε ότι ο Χριστός είναι η κεφαλή;",
      "answer": "Οι ιεράρχες μπορούν να ιδωθούν ως διακονία ποιμαντικής ευθύνης και διδασκαλίας, όχι ως αντικατάσταση του Χριστού ή ανώτερη ανθρώπινη κάστα."
    },
    {
      "character_id": "aristotle",
      "question": "Πώς ελέγχεις αν μια αντιστοίχιση μέλους και διακονίας εξηγεί κάτι ή επιβάλλει αυθαίρετη ιεραρχία;",
      "answer": "Σύγκρινε λειτουργία, κοινό όφελος και όρια. Αν σέβεται την αλληλεξάρτηση, είναι χρήσιμη ως αναλογία."
    },
    {
      "character_id": "hypatia",
      "question": "Πώς γίνεται η εικόνα του σώματος εργαλείο κριτικής σκέψης για τη σχολική κοινότητα;",
      "answer": "Χαρτογραφούμε ρόλους, εντοπίζουμε ποιοι μένουν αόρατοι και προτείνουμε τρόπους ώστε γνώση, φροντίδα και ευθύνη να υπηρετούν όλους."
    }
  ],
  "facts": [
    {
      "character_id": "socrates",
      "fact": "Η παύλεια εικόνα του σώματος μετατρέπει τη διαφορά λειτουργιών σε σχέση και αλληλεξάρτηση, όχι σε κατάταξη αξίας."
    },
    {
      "character_id": "monk compressed.glb",
      "fact": "Ο Χριστός παραμένει η κεφαλή της Εκκλησίας· οι ιεράρχες παρουσιάζονται ως φορείς ποιμαντικής και διδακτικής διακονίας."
    },
    {
      "character_id": "aristotle",
      "fact": "Μια καλή αναλογία ελέγχεται από τη λειτουργία, το κοινό όφελος και τα όριά της."
    },
    {
      "character_id": "hypatia",
      "fact": "Η εικόνα του σώματος βοηθά να αναγνωριστούν και οι αφανείς μορφές φροντίδας μιας κοινότητας."
    }
  ],
